<div class="loginContainer">
    <h1>Ingresa al servidor</h1>
    <form class="login" action="/api/sessions/login" method="POST">
        <label for="user">Usuario:</label>
        <input id="user", name="email" type="text" placeholder="Nombre de usuario">
        <label for="password">Contraseña:</label>
        <input type="password" name="password" id="password" placeholder="Ej: 1234">
        <button type="submit">Ingresar</button>
    </form>
    <div class="loginRegister">
        <p>¿No estas registrado?</p>
        <button><a href="/api/sessions/register">Crear una cuenta</a></button>
    </div>
</div>